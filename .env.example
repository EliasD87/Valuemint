# ---------------------------------------------------------------- storage ---
# Filebase (S3 API over IPFS) takes every new creator upload.
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=

# Pinata is frozen — nothing writes to it any more — but the three existing
# collections are pinned there, so the gateway is still needed to serve them.
# PINATA_JWT is no longer required.
PINATA_GATEWAY=

# --------------------------------------------------------------- identity ---
# Baked into every collection's permanent baseURI at creation time. Set this
# BEFORE anyone creates a collection: a collection made while this points at
# localhost has "localhost" in its metadata URL forever.
SITE_URL=https://www.valuemint.store

# ------------------------------------------------------------ rate limits ---
# Without these the limiter falls back to per-instance memory, which on
# serverless means the limit is bypassable under concurrency. Production warns
# loudly at boot when they are missing. Vercel KV or Upstash both work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Minimum SOSO an address must hold before it may pin. Optional, default 0.001.
PIN_MIN_BALANCE_SOSO=

# ---------------------------------------------------------------- wallets ---
# Free, from cloud.reown.com. Without it WalletConnect is skipped and mobile
# wallets cannot connect outside their own in-app browsers.
# Public by design — it identifies the dApp to the relay and grants nothing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------- rpc ----
# Comma separated, in preference order. Optional: falls back to the public
# ValueChain endpoints. Point BOTH at a private node before any real traffic —
# they sit in the same ranked fallback, so setting only one leaves the rest of
# the traffic on the public node.
#
# NEXT_PUBLIC_, so whatever is here ships in the browser bundle and anyone can
# read it. That is unavoidable: the reads happen in the visitor's browser. So a
# private endpoint here must be one that is safe to publish — restricted by
# origin/referrer to this site, or rate limited per caller by whoever runs it.
# A secret key in the URL would not stay secret.
NEXT_PUBLIC_RPC_URLS=
NEXT_PUBLIC_RPC_WS_URLS=

# --------------------------------------------------------- trust & safety ---
# Comma-separated collection addresses to stop listing, on top of the compiled
# list in config/hidden.ts. Changing this needs no code change.
NEXT_PUBLIC_HIDDEN_COLLECTIONS=

# -------------------------------------------------------------- trenches ----
# The claim authoriser's private key. The contract mints whatever this signs,
# so it is the whole collection: keep it off the deployer and rotate with
# setAuthoriser if it leaks.
TRENCHES_SIGNER_KEY=
NEXT_PUBLIC_TRENCHES_ADDRESS=
# Only set to point a local build at a local chain. Defaults to 286623.
NEXT_PUBLIC_TRENCHES_CHAIN_ID=

# ----------------------------------------------------------------- index ---
# The Supabase project that caches the order book. Everything it holds is
# public chain state, so losing it costs speed and nothing else: with
# SUPABASE_URL unset the site reads the chain directly, exactly as it always
# has. That fallback is the reason this is safe to switch off at any moment.
#
# SUPABASE_SERVICE_KEY bypasses row level security and can write every table.
# It is server-only. NEVER prefix either of these with NEXT_PUBLIC_ — that
# would compile the key into the browser bundle and hand the whole database to
# anyone who opens devtools. There is deliberately no anon key here: nothing
# in the browser talks to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Shared secret the sync route requires, so only the cron can advance the
# index. Any long random string.
INDEX_SYNC_SECRET=
