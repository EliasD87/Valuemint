# ---------------------------------------------------------------- storage ---
# Filebase (S3 API over IPFS) takes every new creator upload.
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=

# Pinata is frozen — nothing writes to it any more — but the three existing
# collections are pinned there, so the gateway is still needed to serve them.
# PINATA_JWT is no longer required.
PINATA_GATEWAY=

# --------------------------------------------------------------- identity ---
# Baked into every collection's permanent baseURI at creation time. Set this
# BEFORE anyone creates a collection: a collection made while this points at
# localhost has "localhost" in its metadata URL forever.
SITE_URL=https://www.valuemint.store

# ------------------------------------------------------------ rate limits ---
# Without these the limiter falls back to per-instance memory, which on
# serverless means the limit is bypassable under concurrency. Production warns
# loudly at boot when they are missing. Vercel KV or Upstash both work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Minimum SOSO an address must hold before it may pin. Optional, default 0.001.
PIN_MIN_BALANCE_SOSO=

# ---------------------------------------------------------------- wallets ---
# Free, from cloud.reown.com. Without it WalletConnect is skipped and mobile
# wallets cannot connect outside their own in-app browsers.
# Public by design — it identifies the dApp to the relay and grants nothing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------- rpc ----
# Comma separated, in preference order. Optional: falls back to the two public
# ValueChain endpoints. Point this at a private node before any real traffic.
NEXT_PUBLIC_RPC_URLS=

# --------------------------------------------------------- trust & safety ---
# Comma-separated collection addresses to stop listing, on top of the compiled
# list in config/hidden.ts. Changing this needs no code change.
NEXT_PUBLIC_HIDDEN_COLLECTIONS=

# -------------------------------------------------------------- trenches ----
# The claim authoriser's private key. The contract mints whatever this signs,
# so it is the whole collection: keep it off the deployer and rotate with
# setAuthoriser if it leaks.
TRENCHES_SIGNER_KEY=
NEXT_PUBLIC_TRENCHES_ADDRESS=
# Only set to point a local build at a local chain. Defaults to 286623.
NEXT_PUBLIC_TRENCHES_CHAIN_ID=
