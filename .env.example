# Copy to .env.local and fill in. Never commit the filled-in file.
# On Vercel these go in Project Settings -> Environment Variables.

# --- Pinata: serves the artwork for collections created before Filebase ------
# Read-only in practice now; nothing new is written here.
PINATA_JWT=
# The gateway hostname, e.g. your-gateway.mypinata.cloud
# Not a secret: it is embedded in every token's on-chain tokenURI.
PINATA_GATEWAY=

# --- Filebase: where creator uploads go -------------------------------------
# S3 API credentials. The bucket must be on Filebase's IPFS network, or uploads
# return no CID and lib/filebase.ts will refuse them.
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=

# --- Optional ---------------------------------------------------------------
# Minimum SOSO a wallet must hold to upload artwork. Defaults to 0.001.
# PIN_MIN_BALANCE_SOSO=0.001

# The public origin baked into a new collection's immutable baseURI.
# Defaults to https://www.valuemint.store. Set this if the domain changes,
# BEFORE anyone creates a collection - it cannot be corrected afterwards.
# SITE_URL=https://www.valuemint.store
